{
  "name": "@Qedami/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "seed": "export $(grep -v '^#' ../../.env | xargs) && mongosh \"$DATABASE_URL\" ../../seed.js"
  },
  "dependencies": {
    "@Qedami/env": "workspace:*",
    "dotenv": "catalog:",
    "mongoose": "^8.14.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Qedami/config": "workspace:*",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
