{
  "name": "Qedami",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "dev:native": "pnpm --filter native dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev"
  },
  "dependencies": {
    "@Qedami/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Qedami/config": "workspace:*",
    "@types/node": "^22.13.14",
    "@types/react": "~19.1.17",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.28.2"
}
