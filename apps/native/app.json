{
  "expo": {
    "scheme": "Qedami",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "statusBar": {
      "barStyle": "auto",
      "backgroundColor": "#00000000"
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "name": "Qedami",
    "slug": "Qedami",
    "plugins": [
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "com.Qedami"
    }
  }
}
